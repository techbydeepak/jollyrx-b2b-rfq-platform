POST http://localhost:3000/api/rfq
Content-Type: application/json

{
  "masked_node_id": "NODE-INVALID-99",
  "buyer_name": "QA Test Buyer",
  "buyer_email": "qa.test@example.com",
  "target_quantity": 5000
}

