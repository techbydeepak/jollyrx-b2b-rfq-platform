{
    if(input.Target_Quantity < plantRecord.MOQ)
    {
        alert "Target quantity (" + input.Target_Quantity + ") is below the required Minimum Order Quantity (" + plantRecord.MOQ + ") for " + input.Masked_Node_ID + ".";
        cancel submit;
    }
}
*/

// --------------------------------------------------------------------------
// 2. ON SUCCESS (Auto-populate Submission Date and default Status to 'New')
// --------------------------------------------------------------------------
// Set current system timestamp
input.Submission_Date = zoho.currenttime;

// Guarantee Status is initialized to 'New' if not already set
if(input.Status == null || input.Status == "")
{
    input.Status = "New";
}
